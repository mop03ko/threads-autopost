{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "threads-autopost-cron",
  "main": "src/index.js",
  "compatibility_date": "2026-08-28",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "GITHUB_OWNER": "mop03ko",
    "GITHUB_REPO": "threads-autopost",
    "GITHUB_BRANCH": "main",
    "QUEUE_PATH": "queue.json",
    "LATE_GRACE_MINUTES": "10080",
    "MAX_POSTS_PER_RUN": "3",
    "MAX_POSTS_PER_DAY": "15"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }

  // Токеныг автоматаар сунгаж хадгалахын тулд Dashboard дээр STATE нэртэй
  // Workers KV binding нэмнэ. Namespace ID-г source control-д placeholder-аар
  // оруулахгүй; бодит binding-ийг Dashboard/Wrangler орчноос холбоно.
}
