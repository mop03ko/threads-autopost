{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "threads-autopost-cron",
  "main": "src/index.js",
  "compatibility_date": "2026-08-28",
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "GITHUB_OWNER": "mop03ko",
    "GITHUB_REPO": "threads-autopost",
    "GITHUB_BRANCH": "main",
    "GITHUB_WORKFLOW": "threads-post.yml",
    "DISPATCH_ENABLED": "true"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
