# Meta Developer дээрх Threads апп-ын мэдээлэл
# Эдгээрийг App Dashboard -> Threads -> Settings хэсгээс авна.

THREADS_APP_ID=энд_апп_ID_бичнэ
THREADS_APP_SECRET=энд_апп_нууц_түлхүүр_бичнэ

# Meta апп дээр бүртгүүлсэн буцах хаяг. Яг ижил байх ёстой.
THREADS_REDIRECT_URI=https://localhost/threads-auth

# Цагийн бүс (сонголт). Анхдагч нь Asia/Ulaanbaatar
THREADS_TZ=Asia/Ulaanbaatar

# --- Google Sheet (сонголт) ---
# Ээлжээ Google Sheet дээрээс засах бол Sheet ID-г энд бичнэ.
# ID нь хаягийн /d/ ба /edit хоёрын хоорондох урт текст.
# Service account ашиглавал Sheet-ээ client_email-д Editor эрхээр хуваалцана.
# Secret байхгүй үед зөвхөн нийтэд нээлттэй CSV-г уншина.

THREADS_SHEET_ID=1nVy7ZcU-3XyTcAKaPkP7V6DZq5XvXZRy3sQ4uhS__6Y

# Постын табыг тодорхой заана; буруу gid байвал зогсоно.
THREADS_SHEET_GID=1131908690
# GOOGLE_SERVICE_ACCOUNT_JSON={...}

# Live горим GitHub дахь нэг ээлжийг ашиглана. Нууцыг git-д бүү оруул.
GITHUB_REPOSITORY=mop03ko/threads-autopost
# GITHUB_TOKEN=Contents_read_write_эрхтэй_токен
THREADS_QUEUE_BRANCH=main
THREADS_LATE_GRACE=90
THREADS_SYNC_MAX_AGE=1800
